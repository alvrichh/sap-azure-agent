# sap-azure-agent: local configuration template
#
#   cp .env.example .env        # .env is ignored by Git, never commit it
#   set -a; source .env; set +a # load into your shell before running the example scripts and az commands
#
# Rules
# - This file holds identifiers, host names and URLs. Real secrets (SAP passwords, Snowflake private keys,
#   client secrets) belong in Azure Key Vault. Deployed services read them through Key Vault references
#   and managed identities; here you only write the *name* of the secret (variables ending in _SECRET_NAME).
# - A few short-lived or local-only values (tokens, SAS trigger URLs, a key passphrase) are left empty here.
#   Fill them only in your local .env, or better, export them in the shell when you need them.
# - Values in <angle-brackets> are placeholders. `python3 scripts/check_env_example.py` (also run in CI)
#   fails if this template ever contains a real secret.

# --------------------------------------------------------------------------------------------------
# Microsoft Entra ID / Azure
# --------------------------------------------------------------------------------------------------
AZURE_TENANT_ID=<tenant-id>
AZURE_SUBSCRIPTION_ID=<subscription-id>
AZURE_LOCATION=westeurope
AZURE_RESOURCE_GROUP=<resource-group>
# App registration or user-assigned identity used by GitHub Actions through OIDC (an identifier, not a secret)
AZURE_CLIENT_ID=<client-id>
AZURE_KEY_VAULT_NAME=<key-vault-name>
# Subnet delegated to Microsoft.Web/serverFarms with a network path to SAP (Logic Apps examples)
AZURE_INTEGRATION_SUBNET_ID=<integration-subnet-resource-id>

# --------------------------------------------------------------------------------------------------
# Data Factory, ADLS Gen2 and Microsoft Fabric
# --------------------------------------------------------------------------------------------------
ADF_FACTORY_NAME=<data-factory-name>
ADF_SELF_HOSTED_IR_NAME=<self-hosted-ir-name>
ADLS_ACCOUNT_NAME=<storage-account-name>
FABRIC_CAPACITY_NAME=<fabric-capacity-name>
FABRIC_WORKSPACE_ID=<fabric-workspace-id>
FABRIC_LAKEHOUSE_ID=<fabric-lakehouse-id>

# --------------------------------------------------------------------------------------------------
# Microsoft Graph / Teams (examples/graph-teams-approvals)
# --------------------------------------------------------------------------------------------------
GRAPH_CLIENT_ID=<graph-app-client-id>
TEAMS_TEAM_ID=<team-id>
TEAMS_CHANNEL_ID=<channel-id>
EVENTHUBS_NAMESPACE=<event-hubs-namespace>
GRAPH_SUBSCRIPTION_ID=<graph-subscription-id>
# Local only: access token from scripts/get_token.py (expires in about an hour)
GRAPH_TOKEN=
# Local only: random value you chose for the subscription's clientState
CLIENT_STATE=

# --------------------------------------------------------------------------------------------------
# API Management in front of SAP OData (examples/sap-odata-apim)
# --------------------------------------------------------------------------------------------------
APIM_NAME=<apim-name>
GATEWAY_URL=https://<apim-name>.azure-api.net
API_PATH=sap/opu/odata/sap/API_BUSINESS_PARTNER
AUTH_MODE=sandbox
TEST_BP=<business-partner-id>
RATE_LIMIT_CALLS=60
# Local only: tokens for the API audience (az account get-access-token --scope <api-app-id-uri>/.default)
TOKEN_READER=
TOKEN_WRITER=
TOKEN_NOROLE=

# --------------------------------------------------------------------------------------------------
# Logic Apps Standard (examples/logicapps-sap-rfc, examples/logicapps-sap-idoc)
# --------------------------------------------------------------------------------------------------
LOGIC_APP_NAME=<logic-app-name>
# Local only: workflow trigger URLs contain a SAS signature (sig=...) and act as secrets
PING_TRIGGER_URL=
AVAIL_TRIGGER_URL=
IDOC_SEND_TRIGGER_URL=
IDOC_STATUS_TRIGGER_URL=
# Downstream API that receives SAP customer master data (called with the logic app's managed identity)
CUSTOMER_API_URL=<customer-api-url>
CUSTOMER_API_AUDIENCE=<customer-api-app-id-uri>

# --------------------------------------------------------------------------------------------------
# SAP system
# --------------------------------------------------------------------------------------------------
SAP_SYSTEM_ID=<sid>
SAP_CLIENT=<sap-client>
SAP_LANGUAGE=EN
# Application server logon (dispatcher port 32<NN>, gateway port 33<NN>)
SAP_APPSERVER_HOST=<sap-app-server-host>
SAP_SYSTEM_NUMBER=<system-number>
# Load-balanced logon (production): message server and logon group from SMLG
SAP_MESSAGE_SERVER_HOST=<sap-message-server-host>
SAP_MESSAGE_SERVER_SERVICE=<sap-message-server-service>
SAP_LOGON_GROUP=<logon-group>
# Technical user (not a secret); its password lives only in Key Vault under this secret name
SAP_USER=<sap-technical-user>
SAP_PASSWORD_SECRET_NAME=sap-rfc-password
# Registered server program for SAP -> Azure (Logic Apps SAP trigger); program ID is case-sensitive
SAP_GATEWAY_HOST=<sap-gateway-host>
SAP_GATEWAY_SERVICE=<sap-gateway-service>
SAP_PROGRAM_ID=<program-id>
# IDoc partners (BD54 logical systems, WE21 ports, WE20 partner profiles)
SAP_LOGICAL_SYSTEM=<sap-logical-system>
SAP_IDOC_SENDER_PORT=<sender-port>
SAP_IDOC_SENDER_PARTNER=LOGICAPP
SAP_IDOC_RECEIVER_PORT=<receiver-port>
SAP_IDOC_RECEIVER_PARTNER=<sap-logical-system>
# SAP Gateway OData and Fiori (HTTPS)
SAP_ODATA_BASE_URL=https://<sap-gateway-host>:<https-port>/sap/opu/odata/sap
SAP_FIORI_URL=https://<sap-fiori-host>/sap/bc/ui2/flp
# SAP CDC / ODP subscriber for Data Factory (uppercase, unique, max 32 characters)
SAP_ODP_SUBSCRIBER_NAME=<odp-subscriber-name>

# --------------------------------------------------------------------------------------------------
# Snowflake (Data Factory SnowflakeV2 connector, local snowsql / Python connector)
# --------------------------------------------------------------------------------------------------
# Account identifier in <orgname>-<account-name> form
SNOWFLAKE_ACCOUNT=<orgname-account-name>
SNOWFLAKE_USER=<snowflake-service-user>
SNOWFLAKE_ROLE=<snowflake-role>
SNOWFLAKE_WAREHOUSE=<snowflake-warehouse>
SNOWFLAKE_DATABASE=<snowflake-database>
SNOWFLAKE_SCHEMA=<snowflake-schema>
# Key-pair authentication (no passwords). Local tools read the key file from a path OUTSIDE the repository.
SNOWFLAKE_AUTHENTICATOR=SNOWFLAKE_JWT
SNOWFLAKE_PRIVATE_KEY_PATH=<path-outside-repo-to-rsa-key.p8>
# Local only: passphrase of an encrypted key (leave empty for unencrypted keys)
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE=
# Data Factory reads the key and passphrase from Key Vault under these secret names
SNOWFLAKE_PRIVATE_KEY_SECRET_NAME=snowflake-private-key
SNOWFLAKE_PRIVATE_KEY_PASSPHRASE_SECRET_NAME=snowflake-private-key-passphrase
# Storage integration for COPY INTO through Azure storage without SAS tokens
SNOWFLAKE_STORAGE_INTEGRATION=<snowflake-storage-integration>
SNOWFLAKE_STAGING_ACCOUNT_NAME=<staging-storage-account-name>
