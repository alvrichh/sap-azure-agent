{
  "name": "PL_Sap_To_Snowflake",
  "properties": {
    "description": "Metadata-driven load of SAP tables into Snowflake: SAP Table (RFC) -> ADLS Parquet -> Snowflake landing (staged COPY INTO via storage integration) -> row-count reconciliation -> MERGE into the core table. Control file generated by tools/generate.py.",
    "concurrency": 1,
    "parameters": {
      "controlFileSystem": {
        "type": "string",
        "defaultValue": "config"
      },
      "controlFileName": {
        "type": "string",
        "defaultValue": "sap-snowflake-objects.json"
      },
      "rawFileSystem": {
        "type": "string",
        "defaultValue": "raw"
      }
    },
    "activities": [
      {
        "name": "LookupObjects",
        "type": "Lookup",
        "policy": {
          "timeout": "0.00:10:00",
          "retry": 1,
          "retryIntervalInSeconds": 30
        },
        "typeProperties": {
          "source": {
            "type": "JsonSource",
            "storeSettings": {
              "type": "AzureBlobFSReadSettings",
              "recursive": false
            }
          },
          "dataset": {
            "referenceName": "DS_AdlsJson",
            "type": "DatasetReference",
            "parameters": {
              "fileSystem": "@pipeline().parameters.controlFileSystem",
              "fileName": "@pipeline().parameters.controlFileName"
            }
          },
          "firstRowOnly": false
        }
      },
      {
        "name": "ForEachObject",
        "type": "ForEach",
        "dependsOn": [
          {
            "activity": "LookupObjects",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('LookupObjects').output.value",
            "type": "Expression"
          },
          "isSequential": false,
          "batchCount": 3,
          "activities": [
            {
              "name": "CopySapToAdls",
              "type": "Copy",
              "policy": {
                "timeout": "0.06:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 120
              },
              "inputs": [
                {
                  "referenceName": "DS_SapTable",
                  "type": "DatasetReference",
                  "parameters": {
                    "tableName": "@item().sapTable"
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "DS_AdlsParquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "fileSystem": "@pipeline().parameters.rawFileSystem",
                    "folderPath": "@concat('sap/', item().sapTable, '/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', pipeline().RunId)"
                  }
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "SapTableSource",
                  "rfcTableFields": {
                    "value": "@item().sapFields",
                    "type": "Expression"
                  },
                  "rfcTableOptions": {
                    "value": "@item().sapFilter",
                    "type": "Expression"
                  },
                  "partitionOption": "None"
                },
                "sink": {
                  "type": "ParquetSink",
                  "storeSettings": {
                    "type": "AzureBlobFSWriteSettings"
                  }
                }
              }
            },
            {
              "name": "CopyAdlsToSnowflakeLanding",
              "type": "Copy",
              "dependsOn": [
                {
                  "activity": "CopySapToAdls",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.06:00:00",
                "retry": 2,
                "retryIntervalInSeconds": 120
              },
              "inputs": [
                {
                  "referenceName": "DS_AdlsParquet",
                  "type": "DatasetReference",
                  "parameters": {
                    "fileSystem": "@pipeline().parameters.rawFileSystem",
                    "folderPath": "@concat('sap/', item().sapTable, '/load_date=', formatDateTime(pipeline().TriggerTime, 'yyyy-MM-dd'), '/run=', pipeline().RunId)"
                  }
                }
              ],
              "outputs": [
                {
                  "referenceName": "DS_SnowflakeV2Table",
                  "type": "DatasetReference",
                  "parameters": {
                    "schema": "@item().landingSchema",
                    "table": "@item().landingTable"
                  }
                }
              ],
              "typeProperties": {
                "source": {
                  "type": "ParquetSource",
                  "storeSettings": {
                    "type": "AzureBlobFSReadSettings",
                    "recursive": true
                  }
                },
                "sink": {
                  "type": "SnowflakeV2Sink",
                  "preCopyScript": {
                    "value": "@concat('TRUNCATE TABLE ', item().landingSchema, '.', item().landingTable)",
                    "type": "Expression"
                  },
                  "importSettings": {
                    "type": "SnowflakeImportCopyCommand",
                    "storageIntegration": "ADF_SAP_AZURE_INT"
                  }
                },
                "enableStaging": true,
                "stagingSettings": {
                  "linkedServiceName": {
                    "referenceName": "LS_BlobStaging",
                    "type": "LinkedServiceReference"
                  },
                  "path": "snowflake-staging"
                }
              }
            },
            {
              "name": "CountLandingRows",
              "type": "Lookup",
              "dependsOn": [
                {
                  "activity": "CopyAdlsToSnowflakeLanding",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "policy": {
                "timeout": "0.00:10:00",
                "retry": 1,
                "retryIntervalInSeconds": 30
              },
              "typeProperties": {
                "source": {
                  "type": "SnowflakeV2Source",
                  "query": {
                    "value": "@item().countSql",
                    "type": "Expression"
                  }
                },
                "dataset": {
                  "referenceName": "DS_SnowflakeV2Table",
                  "type": "DatasetReference",
                  "parameters": {
                    "schema": "@item().landingSchema",
                    "table": "@item().landingTable"
                  }
                },
                "firstRowOnly": true
              }
            },
            {
              "name": "IfRowCountsMatch",
              "type": "IfCondition",
              "dependsOn": [
                {
                  "activity": "CountLandingRows",
                  "dependencyConditions": [
                    "Succeeded"
                  ]
                }
              ],
              "typeProperties": {
                "expression": {
                  "value": "@equals(int(activity('CopySapToAdls').output.rowsCopied), int(activity('CountLandingRows').output.firstRow.ROW_COUNT))",
                  "type": "Expression"
                },
                "ifTrueActivities": [
                  {
                    "name": "MergeIntoCore",
                    "type": "Script",
                    "linkedServiceName": {
                      "referenceName": "LS_SnowflakeV2",
                      "type": "LinkedServiceReference"
                    },
                    "policy": {
                      "timeout": "0.02:00:00",
                      "retry": 1,
                      "retryIntervalInSeconds": 60
                    },
                    "typeProperties": {
                      "scripts": [
                        {
                          "type": "NonQuery",
                          "text": {
                            "value": "@replace(item().mergeSql, '{runId}', pipeline().RunId)",
                            "type": "Expression"
                          }
                        }
                      ],
                      "scriptBlockExecutionTimeout": "02:00:00"
                    }
                  }
                ],
                "ifFalseActivities": [
                  {
                    "name": "FailOnRowCountMismatch",
                    "type": "Fail",
                    "typeProperties": {
                      "message": {
                        "value": "@concat(item().sapTable, ': SAP rows ', string(activity('CopySapToAdls').output.rowsCopied), ' but Snowflake landing has ', string(activity('CountLandingRows').output.firstRow.ROW_COUNT), '. Core table not changed.')",
                        "type": "Expression"
                      },
                      "errorCode": "ROWCOUNT_MISMATCH"
                    }
                  }
                ]
              }
            }
          ]
        }
      }
    ]
  }
}
