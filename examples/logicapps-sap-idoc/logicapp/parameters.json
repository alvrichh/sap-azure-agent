{
  "sapGatewayHost": {
    "type": "String",
    "value": "@appsetting('SAP_GATEWAY_HOST')"
  },
  "sapGatewayService": {
    "type": "String",
    "value": "@appsetting('SAP_GATEWAY_SERVICE')"
  },
  "sapProgramId": {
    "type": "String",
    "value": "@appsetting('SAP_PROGRAM_ID')"
  },
  "idocSenderPort": {
    "type": "String",
    "value": "@appsetting('SAP_IDOC_SENDER_PORT')"
  },
  "idocSenderPartner": {
    "type": "String",
    "value": "@appsetting('SAP_IDOC_SENDER_PARTNER')"
  },
  "idocReceiverPort": {
    "type": "String",
    "value": "@appsetting('SAP_IDOC_RECEIVER_PORT')"
  },
  "idocReceiverPartner": {
    "type": "String",
    "value": "@appsetting('SAP_IDOC_RECEIVER_PARTNER')"
  },
  "customerApiUrl": {
    "type": "String",
    "value": "@appsetting('CUSTOMER_API_URL')"
  },
